#!/usr/bin/env bash
# Orb setup — runs once when a fresh orb is created, before Amp starts working.
# Installs the Node 22 toolchain and project dependencies, then sanity-checks
# the build. Must be non-interactive and idempotent.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> AnyLLMTranslate orb setup"

# The orb ships Node 20.9.0, but .nvmrc pins 22 and the bundled pnpm 10
# requires Node >=22.13. Install Node 22 via `n` (replaces /usr/local node).
if ! command -v n >/dev/null 2>&1; then
  echo "==> Installing n (Node version manager)"
  sudo npm install -g n
fi

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [[ "${NODE_MAJOR}" -lt 22 ]]; then
  echo "==> Installing Node 22 (current: $(node --version 2>/dev/null || echo none))"
  sudo n 22
  echo "==> Node now: $(node --version)"
else
  echo "==> Node $(node --version) already satisfies .nvmrc (22)"
fi

# Ensure pnpm is available. The preinstalled pnpm survives `n 22`, but if it
# is missing for any reason, activate it via corepack (bundled with Node 22).
if ! command -v pnpm >/dev/null 2>&1; then
  echo "==> Activating pnpm via corepack"
  sudo corepack enable
  sudo corepack prepare pnpm@latest --activate
fi
echo "==> pnpm: $(pnpm --version)"

# Install dependencies from the lockfile. The npm lockfile is the canonical,
# in-sync one (pnpm-lock.yaml is stale); `npm ci` is deterministic and fast.
echo "==> Installing dependencies (npm ci)"
npm ci

# Sanity check: the extension builds. (tsc --noEmit has pre-existing errors
# in test files unrelated to the build; WXT uses esbuild, so `wxt build` is
# the meaningful "does this build" signal.)
echo "==> Building extension (wxt build)"
npm run build

echo "==> Setup complete."
